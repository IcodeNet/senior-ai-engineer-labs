  "actions": [
    {
      "id": "azure-prices",
      "label": "Lab 03 · Show live Azure prices (no sign-in)",
      "script": "azure:prices",
      "group": "Lab 03 · Real Azure",
      "description": "Reads list prices for the configured region from the public Azure Retail Prices API. Needs no Azure sign-in and creates nothing."
    },
    {
      "id": "azure-plan",
      "label": "Lab 03 · Plan Azure set-up (creates nothing)",
      "script": "azure:plan",
      "group": "Lab 03 · Real Azure",
      "description": "Checks your az login, that azure/config.json's models are offered in your region, and shows live list prices. Read-only."
    },
    {
      "id": "azure-up",
      "label": "Lab 03 · Set up Azure (billable)",
      "script": "azure:up",
      "group": "Lab 03 · Real Azure",
      "description": "Creates one course-tagged resource group with Azure AI Search Basic (billed every hour until shut down) and Azure OpenAI (per token). Asks you to type \"create\".",
      "destructive": true,
      "cancelGraceSeconds": 120
    },
    {
      "id": "azure-status",
      "label": "Lab 03 · Azure status and cost so far",
      "script": "azure:status",
      "group": "Lab 03 · Real Azure",
      "description": "Lists what is running in the course resource group and estimates the search cost so far. Read-only."
    },
    {
      "id": "azure-down",
      "label": "Lab 03 · Shut down Azure (delete everything)",
      "script": "azure:down",
      "group": "Lab 03 · Real Azure",
      "description": "Deletes the course-tagged resource group and purges the soft-deleted Azure OpenAI account, then verifies. Asks you to type the resource group name.",
      "destructive": true,
      "cancelGraceSeconds": 120
    },
    {
      "id": "azure-verify",
      "label": "Lab 03 · Verify cost is zero",
      "script": "azure:verify",
      "group": "Lab 03 · Real Azure",
      "description": "Checks the subscription for anything left with the course tag, including soft-deleted accounts. Clears the cost banner only when nothing remains."
    }
  ],
  "indicators": [
    {
      "path": ".azure/env.json",
      "message": "Lab 03 Azure resources exist (course/.azure/env.json): Azure AI Search Basic is billed every hour. When you finish, run “Shut down Azure” and then “Verify cost is zero” in the Actions tab.",
      "level": "danger"
    },
    {
      "path": ".azure/resources-may-exist.json",
      "message": "Paid Lab 03 Azure resources may exist: a set-up or shutdown did not finish, or a check found course resources. Run “Shut down Azure”, then “Verify cost is zero”; this banner clears only when Verify finds nothing.",
      "level": "danger"
    },
    {
      "path": ".azure/cost-status-unknown.json",
      "message": "Cost status unknown: the last Azure check failed (reason in course/.azure/cost-status-unknown.json). Paid Lab 03 resources may still exist. Sign in with az login and run “Verify cost is zero”.",
      "level": "danger"
    }
  ]
