  "actions": [
    {
      "id": "azure-prices",
      "label": "Module 3 · Show live Azure prices (no sign-in)",
      "script": "azure:prices",
      "group": "Module 3 · Azure",
      "description": "Reads list prices for the configured region from the public Azure Retail Prices API. Needs no Azure sign-in and creates nothing."
    },
    {
      "id": "azure-plan",
      "label": "Module 3 · Plan Azure set-up (creates nothing)",
      "script": "azure:plan",
      "group": "Module 3 · Azure",
      "description": "Checks your az login, that azure/config.json's models are offered in your region, and shows live list prices. Read-only."
    },
    {
      "id": "azure-up",
      "label": "Module 3 · Set up Azure (billable)",
      "script": "azure:up",
      "group": "Module 3 · Azure",
      "description": "Creates one course-tagged resource group with Azure AI Search Basic (billed every hour until shut down), Azure OpenAI (per token) and a Storage account for the indexers (per GB and operation). Asks you to type \"create\".",
      "destructive": true,
      "cancelGraceSeconds": 120
    },
    {
      "id": "azure-status",
      "label": "Module 3 · Azure status and cost so far",
      "script": "azure:status",
      "group": "Module 3 · Azure",
      "description": "Lists what is running in the course resource group and estimates the search cost so far. Read-only."
    },
    {
      "id": "azure-down",
      "label": "Module 3 · Shut down Azure (delete everything)",
      "script": "azure:down",
      "group": "Module 3 · Azure",
      "description": "Deletes the course-tagged resource group (search, Azure OpenAI, storage and role assignments) and purges the soft-deleted Azure OpenAI account, then verifies. Asks you to type the resource group name.",
      "destructive": true,
      "cancelGraceSeconds": 120
    },
    {
      "id": "azure-verify",
      "label": "Module 3 · Verify cost is zero",
      "script": "azure:verify",
      "group": "Module 3 · Azure",
      "description": "Checks the subscription for anything left with the course tag, including soft-deleted accounts. Clears the cost banner only when nothing remains."
    }
  ],
  "indicators": [
    {
      "path": ".azure/env.json",
      "message": "Course Azure resources exist (course/.azure/env.json): Azure AI Search Basic is billed every hour. When you finish, run “Shut down Azure” and then “Verify cost is zero” in the Actions tab.",
      "level": "danger"
    },
    {
      "path": ".azure/resources-may-exist.json",
      "message": "Paid course Azure resources may exist: a set-up or shutdown did not finish, or a check found course resources. Run “Shut down Azure”, then “Verify cost is zero”; this banner clears only when Verify finds nothing.",
      "level": "danger"
    },
    {
      "path": ".azure/cost-status-unknown.json",
      "message": "Cost status unknown: the course cannot confirm what exists in Azure (a check failed, the subscription is unclear, or course/.azure was removed; reason in course/.azure/cost-status-unknown.json). Paid resources may still exist. Sign in to the subscription you used and run “Verify cost is zero”.",
      "level": "danger"
    }
  ],
  "sidecars": {
    "azure-cost-watch": {
      "script": "azure:watch"
    }
  }
}
